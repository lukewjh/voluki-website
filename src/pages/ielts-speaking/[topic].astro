---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SpeakingView from "../../components/SpeakingView.astro";
import { getSpeakingTopicAnswers } from "../../lib/githubSpeaking";
import { speakingCategories, speakingGroups } from "../../lib/speakingBank";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "no-store");

const slug = Astro.params.topic;
const group = speakingGroups.find(({ topics }) => topics.some((topic) => topic.slug === slug));
const index = group?.topics.findIndex((topic) => topic.slug === slug) ?? -1;
const base = group?.topics[index];
const current = base ? await getSpeakingTopicAnswers(Astro, base) : undefined;
const topic = current?.topic;
const part = group?.id;
const partLabel = group?.label;
const previous = group?.topics[index - 1];
const next = group?.topics[index + 1];
const category = speakingCategories.find(({ id }) => id === topic?.category)?.label;
const bankUrl = part === "2-3" ? "/ielts-speaking/?part=2-3" : "/ielts-speaking/";
if (!topic) Astro.response.status = 404;
---

<BaseLayout
  title={(topic?.title ?? "话题未找到") + " · IELTS-Speaking"}
  description={topic ? partLabel + " 口语练习 · " + topic.title : undefined}
>
  {topic ? <article class="speaking-topic">
    <div class="topic-links">
      <a class="topic-back" href={bankUrl}><span aria-hidden="true">←</span> 返回 IELTS-Speaking</a>
    </div>
    <header class="topic-header">
      <p class="topic-meta">{partLabel} <span aria-hidden="true">·</span> {category}</p>
      <h1 lang={part === "1" ? "en" : "zh-CN"}>{topic.title}</h1>
    </header>
    {current?.notice && <p class="speaking-sync-notice" role="status" data-speaking-sync-notice>{current.notice}</p>}

    <SpeakingView topic={topic.slug}>
      {part === "2-3" && (
        <a class="topic-jump" slot="card-actions" href="#part-3">跳到 Part 3 <span aria-hidden="true">↓</span></a>
      )}
      {topic.sections.map((section) => {
        const PromptHeading = section.label ? "h3" : "h2";
        return (
          <section class="question-section" id={section.id} aria-label={section.label ?? partLabel}>
            {section.label && <h2>{section.label}</h2>}
            <div class="question-list">
              {section.questions.map((question) => (
                <article class="question-card" id={question.id} data-speaking-question>
                  <div class="question-content" lang="en">
                    <PromptHeading class="question-prompt">{question.prompt}</PromptHeading>
                    {question.cuePoints && (
                      <div class="cue-points">
                        <p>You should say:</p>
                        <ul>
                          {question.cuePoints.map((point) => <li>{point}</li>)}
                        </ul>
                      </div>
                    )}
                  </div>
                  <details class="answer">
                    <summary>
                      <span class="show-answer">查看答案</span>
                      <span class="hide-answer">收起答案</span>
                      <span class="answer-icon" aria-hidden="true"></span>
                    </summary>
                    <div class="answer-content" lang="en">
                      {question.answers.upgraded && <p class="answer-label" lang="zh-CN">基础版</p>}
                      {question.answers.basic.split("\n\n").map((paragraph) => <p>{paragraph}</p>)}
                      {question.answers.upgraded && (
                        <>
                          <p class="answer-label" lang="zh-CN">升级版</p>
                          {question.answers.upgraded.split("\n\n").map((paragraph) => <p>{paragraph}</p>)}
                        </>
                      )}
                    </div>
                  </details>
                </article>
              ))}
            </div>
          </section>
        );
      })}

      <nav class="topic-navigation" aria-label="相邻话题">
        {previous && (
          <a class="previous-topic" href={"/ielts-speaking/" + previous.slug + "/"}>
            <span><span aria-hidden="true">←</span> 上一个话题</span>
            <strong lang={part === "1" ? "en" : "zh-CN"}>{previous.title}</strong>
          </a>
        )}
        {next && (
          <a class="next-topic" href={"/ielts-speaking/" + next.slug + "/"}>
            <span>下一个话题 <span aria-hidden="true">→</span></span>
            <strong lang={part === "1" ? "en" : "zh-CN"}>{next.title}</strong>
          </a>
        )}
      </nav>
    </SpeakingView>
  </article> : (
    <section class="speaking-topic">
      <h1>话题未找到</h1>
      <a class="topic-back" href={bankUrl}><span aria-hidden="true">←</span> 返回 IELTS-Speaking</a>
    </section>
  )}
</BaseLayout>

<style>
  .speaking-topic {
    max-width: 780px;
    margin: 0 auto;
    padding: clamp(12px, 3vw, 42px) 0 clamp(48px, 7vw, 92px);
  }

  .topic-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    column-gap: 12px;
  }

  .topic-back,
  .topic-jump {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 650;
  }

  .topic-back:hover,
  .topic-jump:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .topic-header {
    margin-top: 16px;
    padding-bottom: clamp(18px, 4vw, 30px);
    border-bottom: 1px solid var(--line);
  }

  .topic-meta {
    margin-bottom: 9px;
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 650;
  }

  h1 {
    max-width: none;
    margin-bottom: 0;
    font-size: clamp(2rem, 6vw, 3.5rem);
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .question-section {
    margin-top: clamp(20px, 4vw, 34px);
    scroll-margin-top: 78px;
  }

  .question-section > h2 {
    margin-bottom: 12px;
    font-size: 1.125rem;
  }

  .question-list {
    display: grid;
    gap: 12px;
  }

  .topic-navigation {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: 10px;
    margin-top: clamp(24px, 4vw, 36px);
  }

  .topic-navigation a {
    display: grid;
    gap: 3px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .topic-navigation a:hover {
    border-color: var(--text);
    background: var(--surface-soft);
  }

  .topic-navigation a > span {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .topic-navigation .next-topic {
    grid-column: 2;
    text-align: right;
  }

  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>
