<div id="rio-talk" hidden>
  <div class="messages" role="log" aria-label="对话记录" aria-live="off" tabindex="0"></div>
  <form>
    <div class="tools">
      <button type="button" data-hint>给我一点提示</button>
      <span role="status"></span><button type="button" data-retry hidden>重试</button>
    </div>
    <div class="composer">
      <input aria-label="你的回复" placeholder="用英语回复…" maxlength="1000" autocomplete="off" enterkeyhint="send" />
      <button type="submit">发送</button>
    </div>
  </form>
</div>

<style>
  #rio-talk:not([hidden]) { display: grid; min-height: 0; grid-template-rows: minmax(0, 1fr) auto; }
  form { padding: 12px 0 0; }
  button { padding: 7px 12px; border: 1px solid var(--line); border-radius: 7px; background: var(--surface); color: inherit; cursor: pointer; font: inherit; }
  button:disabled { opacity: .5; cursor: default; }
  .messages { overflow-y: auto; overscroll-behavior: contain; padding: 12px 1px; }
  .messages :global(p) { width: fit-content; max-width: 88%; margin: 0 0 12px; padding: 10px 13px; background: var(--surface-soft); border-radius: 10px; overflow-wrap: anywhere; white-space: pre-wrap; line-height: 1.5; }
  .messages :global([data-role="user"]) { margin-left: auto; background: var(--accent); color: var(--surface); }
  .messages :global([data-role="hint"]) { border-left: 3px solid var(--line); }
  form { border-top: 1px solid var(--line); }
  .tools, .composer { display: flex; gap: 8px; align-items: center; }
  .tools { margin-bottom: 8px; font-size: 13px; flex-wrap: wrap; }
  .tools button { flex-shrink: 0; }
  input { flex: 1; min-width: 0; height: 44px; padding: 0 10px; border: 1px solid var(--line); border-radius: 7px; background: var(--surface); color: inherit; font: inherit; font-size: 16px; }
  [type="submit"] { height: 44px; background: var(--accent); color: var(--surface); }
</style>
